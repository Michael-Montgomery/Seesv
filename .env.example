# Enable ads rendering in the app
REACT_APP_ENABLE_ADS=false

# Google AdSense publisher ID (format: ca-pub-xxxxxxxxxxxxxxxx)
REACT_APP_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx

# Individual ad unit slot IDs from your AdSense dashboard
REACT_APP_ADSENSE_TOP_BANNER_SLOT=1111111111
REACT_APP_ADSENSE_BOTTOM_BANNER_SLOT=2222222222
REACT_APP_ADSENSE_LEFT_RAIL_SLOT=3333333333
REACT_APP_ADSENSE_RIGHT_RAIL_SLOT=4444444444
